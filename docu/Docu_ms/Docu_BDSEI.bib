  author = {Burgasser, Adam J. and Gonzales, Eileen C. and Beiler, Samuel A. and Visscher, Channon and Burningham, Ben and Mace, Gregory N. and Faherty, Jacqueline K. and Zhang, Zenghua and {Sousa-Silva}, Clara and Lodieu, Nicolas and Metchev, Stanimir A. and Meisner, Aaron and Cushing, Michael and Schneider, Adam C. and Suarez, Genaro and Hsu, Chih-Chun and Gerasimov, Roman and Aganze, Christian and Theissen, Christopher A.},
